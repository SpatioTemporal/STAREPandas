{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DeleteEmptyRdsStarepodsWithFinalSnapshot",
      "Effect": "Allow",
      "Action": [
        "rds:DescribeDBInstances",
        "rds:DescribeDBSnapshots",
        "rds:DeleteDBInstance",
        "rds:CreateDBSnapshot",
        "rds:AddTagsToResource",
        "rds:DeleteDBInstanceAutomatedBackup"
      ],
      "Resource": [
        "arn:aws:rds:us-west-2:637388276731:db:starepods",
        "arn:aws:rds:us-west-2:637388276731:snapshot:starepods-final-2026-10-18",
        "arn:aws:rds:us-west-2:637388276731:auto-backup:*"
      ]
    },
    {
      "Sid": "ReadChecksForBothActions",
      "Effect": "Allow",
      "Action": [
        "rds:DescribeDBInstances",
        "rds:DescribeDBSnapshots",
        "eks:ListClusters",
        "ec2:DescribeNetworkInterfaces",
        "ec2:DescribeInstances",
        "ec2:DescribeNatGateways",
        "ec2:DescribeVpcs",
        "ec2:DescribeSubnets",
        "ec2:DescribeRouteTables",
        "ec2:DescribeInternetGateways",
        "ec2:DescribeSecurityGroups",
        "ec2:DescribeAddresses",
        "cloudformation:ListStacks",
        "cloudformation:DescribeStacks",
        "cloudformation:DescribeStackEvents",
        "cloudformation:DescribeStackResources"
      ],
      "Resource": "*"
    },
    {
      "Sid": "DeleteTheTwoOrphanedEksStacks",
      "Effect": "Allow",
      "Action": "cloudformation:DeleteStack",
      "Resource": [
        "arn:aws:cloudformation:us-east-2:637388276731:stack/EKS-VPC-Stack/*",
        "arn:aws:cloudformation:us-east-2:637388276731:stack/eksctl-EKS-Cluster-addon-iamserviceaccount-kube-system-ebs-csi-controller-sa/*"
      ]
    },
    {
      "Sid": "ResourcesCloudFormationRemovesForEksVpcStack",
      "Effect": "Allow",
      "Action": [
        "ec2:DeleteNatGateway",
        "ec2:ReleaseAddress",
        "ec2:DeleteRoute",
        "ec2:DisassociateRouteTable",
        "ec2:DeleteRouteTable",
        "ec2:DeleteSubnet",
        "ec2:DetachInternetGateway",
        "ec2:DeleteInternetGateway",
        "ec2:DeleteSecurityGroup",
        "ec2:DeleteVpc"
      ],
      "Resource": "*",
      "Condition": { "StringEquals": { "aws:RequestedRegion": "us-east-2" } }
    },
    {
      "Sid": "RoleCloudFormationRemovesForEksctlStack",
      "Effect": "Allow",
      "Action": [
        "iam:GetRole",
        "iam:ListAttachedRolePolicies",
        "iam:ListRolePolicies",
        "iam:DetachRolePolicy",
        "iam:DeleteRolePolicy",
        "iam:DeleteRole"
      ],
      "Resource": [
        "arn:aws:iam::637388276731:role/eksctl-EKS-Cluster-addon-iamserviceaccount-*",
        "arn:aws:iam::637388276731:role/AmazonEKS_EBS_CSI_DriverRole"
      ]
    }
  ]
}
